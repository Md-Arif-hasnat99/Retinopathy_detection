# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables — copy this file to .env and fill in values.
# NEVER commit the actual .env file (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins for the React frontend.
# Local development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Production (add your Vercel URL after deployment):
# ALLOWED_ORIGINS=https://your-project.vercel.app

# Port — Render injects $PORT automatically; you normally do not need to set this.
PORT=8000
